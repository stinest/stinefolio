<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ site.title }} — {{ title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ summary or site.description }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ summary or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fragment+Mono:ital@0;1&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="page-{{ bodyClass or 'default' }}">
  {%- set inResearch = page.url.startsWith("/research") or page.url.startsWith("/projects") -%}
  {%- set inPortfolio = page.url.startsWith("/portfolio") or page.url.startsWith("/designs") -%}
  <header class="site-header">
    <a class="wordmark" href="/">{{ site.name }}</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span class="clover" aria-hidden="true"></span><span class="close">(Close)</span>
    </button>
    <nav class="nav" id="site-nav">
      <a href="/research/" {% if inResearch %}aria-current="page"{% endif %}>Research</a>
      <a href="/portfolio/" {% if inPortfolio %}aria-current="page"{% endif %}>Portfolio</a>
      <a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>About</a>
    </nav>
  </header>

  <main class="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <span class="copy"><span class="c">&copy;</span><span class="yr">{{ site.year }}.</span></span>
    <span class="links">
      <a href="mailto:{{ site.email }}">Email<span class="arr"></span></a>
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn<span class="arr"></span></a>
      <a href="{{ site.cv }}" target="_blank" rel="noopener">CV<span class="arr"></span></a>
    </span>
  </footer>
  <script>
    (() => {
      const b = document.querySelector(".menu-btn");
      const set = (open) => { document.body.classList.toggle("menu-open", open); b.setAttribute("aria-expanded", String(open)); };
      b.addEventListener("click", () => set(!document.body.classList.contains("menu-open")));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") set(false); });
      document.querySelectorAll("#site-nav a").forEach((a) => a.addEventListener("click", () => set(false)));
    })();
  </script>
  {% if scripts %}{% for s in scripts %}<script src="{{ s }}" defer></script>{% endfor %}{% endif %}
</body>
</html>
